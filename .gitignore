# OS metadata
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Desktop.ini
.Spotlight-V100
.Trashes

# Editors / IDE
.idea/
.vscode/
*.code-workspace
*.swp
*.swo

# Python cache (for embedded scripts/knobs)
__pycache__/
*.pyc

# Nuke artifacts
*.autosave
*.nk~
*.backup
*.bak

# Logs and caches
*.log
*.tmp
logs/
**/logs/**
**/cache/**

# CopyCat training byproducts (keep weights out unless explicitly archived)
pipeline/03_copycat_training/**/weights/**
pipeline/03_copycat_training/**/checkpoints/**
pipeline/03_copycat_training/**/artifacts/**
pipeline/03_copycat_training/**/logs/**

# Local environments
.env
.venv/
venv/

# NOTE: QC renders are intentionally tracked to support reviews
# QC/**

# Demo media: only track web proxies, ignore originals
/DEMOS - Exploración del Aprendizaje Automático Experimental en la Restauración de Películas/**/*.mp4
!/DEMOS - Exploración del Aprendizaje Automático Experimental en la Restauración de Películas/**/*_web.mp4

# ffmpeg 2-pass temp logs
ffmpeg2pass-*.log*
# Agent instruction files (not part of repo deliverables)
.aiagents/
.claude/

# Archive directory (development notes, internal docs, presentations)
/archive/

# Local tools (vendored binaries)
/.tools/

# Local docs build artifacts
docs/.bundle/
docs/_site/
docs/vendor/bundle/

# Use kebab-cased images; ignore legacy images folder (OneDrive-owned)
/docs/images/

# Generated manifests/reports (contain private filenames)
/docs/*images*-manifest.yaml
/docs/*images*-rename-plan.csv
/docs/*images*-rename-report.md

